# Copy to .env and fill in. Never commit .env.

# ─── runtime ───────────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO

# ─── database ──────────────────────────────────────────────────────────────
# SQLite (dev). For prod, use Postgres: postgresql+asyncpg://user:pw@host/db
DATABASE_URL=sqlite+aiosqlite:///./pix_billing.db

# ─── crypto ────────────────────────────────────────────────────────────────
# 32-byte url-safe base64 secret used to derive the API-key HMAC and to seed
# the AES-256-GCM key vault on first boot. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# DO NOT REUSE THIS VALUE ACROSS ENVIRONMENTS.
APP_SECRET_KEY=replace-me-with-a-32-byte-urlsafe-secret

# ─── PIX merchant identity (rendered into BR-Code) ────────────────────────
PIX_MERCHANT_NAME=PIX BILLING DEMO
PIX_MERCHANT_CITY=FORTALEZA
PIX_DEFAULT_KEY=demo@pix-billing.dev

# ─── billing limits ────────────────────────────────────────────────────────
CHARGE_DEFAULT_TTL_SECONDS=1800
CHARGE_MIN_CENTS=100
CHARGE_MAX_CENTS=5000000

# ─── webhook delivery ──────────────────────────────────────────────────────
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_TIMEOUT_SECONDS=10

# ─── rate limits (per API key per minute) ─────────────────────────────────
RATE_LIMIT_WRITE_PER_MIN=100
RATE_LIMIT_READ_PER_MIN=300

# ─── Sentry ────────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-dsn@sentry.io/project

# ─── Cloudflare protection (set to "true" only in production) ─────────────
CLOUDFLARE_ONLY=false
